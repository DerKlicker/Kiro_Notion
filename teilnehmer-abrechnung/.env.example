# Kopiere diese Datei zu ".env" und trage deine echten Werte ein.
# Die .env-Datei wird NICHT in Git eingecheckt (siehe .gitignore).

# Notion-Integration-Token (erstellen unter https://www.notion.so/my-integrations)
# Danach die Integration in deiner Datenbank "verbinden/teilen" nicht vergessen.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID der Notion-Datenbank
# Findest du in der URL der Datenbank: notion.so/<workspace>/<DIESE_ID>?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
