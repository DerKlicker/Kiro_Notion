# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env wird NICHT ins Repo committet (siehe .gitignore).
#
# Ab Phase 3 liest auch der Docker-Compose-Stack diese Datei: alle hier
# gelisteten Variablen werden in docker-compose.yml ueber ${...} referenziert.
# Ein Kopieren nach .env genuegt also, um den Stack zu starten.

# Notion-Integration-Token (https://www.notion.so/my-integrations)
# Beginnt mit "ntn_" (neu) oder "secret_" (aelter).
NOTION_TOKEN=

# Passwort der PostgreSQL-DB. Ab Phase 3 zwingend noetig: es wird sowohl von
# der PostgreSQL-Instanz (POSTGRES_PASSWORD) als auch von der App und der
# Grafana-Datenquelle verwendet. Ein starkes, zufaelliges Passwort waehlen.
PG_PASSWORD=

# Intervall des periodischen Sync im etl-cron-Dienst, in Sekunden.
# Optional - Standard ist 86400 (einmal taeglich). Beispiel: 3600 = stuendlich.
SYNC_INTERVALL_SEKUNDEN=86400
