# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env wird NICHT ins Repo committet (siehe .gitignore).

# Notion-Integration-Token (https://www.notion.so/my-integrations)
# Beginnt mit "ntn_" (neu) oder "secret_" (älter).
NOTION_TOKEN=

# Passwort der PostgreSQL-DB (erst ab Phase 3 nötig)
PG_PASSWORD=
